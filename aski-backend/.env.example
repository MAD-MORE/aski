DATABASE_URL=postgresql+psycopg://aski:aski@localhost:5432/aski
# Resilient AI routing. Configure the secrets in the deployment environment, never in Git.
ASKI_PROVIDER_ORDER=gemini,grok,openrouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
XAI_API_KEY=
GROK_MODEL=grok-4.5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
ASKI_SYNC_API_TOKEN=change-me
ASKI_ADMIN_TOKEN=change-me
ASKI_RATE_LIMIT=60
FLASK_DEBUG=false
