{
  "buildCommand": "cd aski-frontend && npm install && npm run build",
  "outputDirectory": "aski-frontend/dist",
  "framework": "vite",
  "installCommand": "cd aski-frontend && npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://aski-theta.vercel.app/api/:path*"
    }
  ]
}
